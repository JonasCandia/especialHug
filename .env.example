# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MERCADO_PAGO_ACCESS_TOKEN: Optional live access token for Mercado Pago integration (defaults to test mode if unset)
MERCADO_PAGO_ACCESS_TOKEN=

# MERCADO_PAGO_PUBLIC_KEY: Optional public key for Mercado Pago integration
MERCADO_PAGO_PUBLIC_KEY=

# ADMIN_PASSWORD: Passcode for administrative backoffice access (default: abraco2025)
ADMIN_PASSWORD="admin"
